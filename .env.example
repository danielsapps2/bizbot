# Required: create a bot with @BotFather in Telegram and paste its token
TELEGRAM_BOT_TOKEN=

# Optional: your Telegram user id, to skip the /pair step
TELEGRAM_OWNER_ID=

# Optional: model for newly hired bots (sonnet, opus, haiku). Default: your Claude Code setting
# DEFAULT_MODEL=sonnet

# Optional: timezone for schedules. Default: the system timezone
# TZ_NAME=America/New_York

# Optional: fal.ai key for the built-in generate_image tool
# (bots can also use a fal MCP server if you've connected one in Claude Code)
FAL_KEY=
# FAL_IMAGE_MODEL=fal-ai/flux/dev

# Optional: pay per use with an API key instead of your Claude subscription
# ANTHROPIC_API_KEY=

# Optional: 1Password vault bots may use for sign-ins (see README "1Password")
# OP_VAULT=BizBot

# Optional: advanced
# BROWSER_HEADLESS=1          # hide the shared Chrome window
# BROWSER_PORT=8931           # Playwright MCP server port
# BROWSER_CDP_PORT=9223       # local Chrome DevTools port used by fill_login
# APPROVAL_TIMEOUT_MIN=60     # unanswered approvals are denied after this long
# USAGE_BOT=meter             # bot that receives usage alerts
# CODE_MODEL=claude-opus-5-5  # model for Claude Code sessions (claude_code tool, /code)
# CODE_EFFORT=high            # low | medium | high | xhigh | max
# USAGE_CHECK_MIN=10          # how often to check plan usage
# BIZBOT_DATA=./data       # where bots, memories and the browser profile live

# Optional nightly shell job run inside BizBot (HH:MM, local time). Leave empty to disable.
# NIGHTLY_COMMAND="/bin/bash /path/to/backup.sh"
# NIGHTLY_AT=02:15
