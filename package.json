{
  "name": "bizbot",
  "version": "1.0.0",
  "description": "Run your business with an AI team: always-on Claude agents with real roles, working on your Mac and reporting to you on Telegram. Powered by your own Claude subscription.",
  "scripts": {
    "start": "node src/index.ts",
    "typecheck": "tsc",
    "service:install": "scripts/install-service.sh",
    "service:uninstall": "scripts/uninstall-service.sh",
    "service:restart": "launchctl kickstart -k gui/$(id -u)/com.bizbot.agent",
    "logs": "tail -f logs/bizbot.log"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.292",
    "@playwright/mcp": "^0.0.83",
    "croner": "^10.0.1",
    "grammy": "^1.46.0",
    "playwright-core": "1.64.0-alpha-1790635538000",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "private": "true",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielsapps2/bizbot.git"
  }
}
